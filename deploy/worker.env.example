# /etc/leetkob/worker.env — read by leetkob-worker.service only (chmod 640, root:leetkob-worker).
# Put the key here on the server, by hand. Never commit it.
DATABASE_PATH=/var/lib/leetkob/leetkob.db
CALLS_LOG=/var/lib/leetkob/calls.jsonl
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_MS=60000
# MODEL_OFF=1 runs the hard rules only (no key needed); semantic constraints are then unsure.
# MODEL_OFF=1
